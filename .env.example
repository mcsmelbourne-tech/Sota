# Copy to .env and fill in. Never commit .env.

# backtest | paper | live   (live = advisory tickets only; the tool never places live orders)
SOTA_MODE=paper
SOTA_SELECTOR=threshold            # threshold | llm | oracle
SOTA_COST_PRESET=paper             # paper | robinhood | ibkr
# SOTA_UNIVERSE=["SPY","QQQ","AAPL","NVDA","TSLA"]

# Alpaca paper account (also used read-only for live quotes in live mode)
SOTA_ALPACA__API_KEY=
SOTA_ALPACA__SECRET_KEY=
SOTA_ALPACA__FEED=indicative       # opra requires the paid options data subscription

# Theta Data (Theta Terminal v3 must be running locally)
SOTA_THETA__BASE_URL=http://127.0.0.1:25503/v3

# LLM selector (any OpenAI-compatible endpoint)
SOTA_LLM__BASE_URL=https://api.openai.com/v1
SOTA_LLM__API_KEY=
SOTA_LLM__MODEL=gpt-4.1

# Notifications
SOTA_NOTIFY__TELEGRAM_BOT_TOKEN=
SOTA_NOTIFY__TELEGRAM_CHAT_ID=
SOTA_NOTIFY__SMTP_HOST=
SOTA_NOTIFY__SMTP_PORT=587
SOTA_NOTIFY__SMTP_USER=
SOTA_NOTIFY__SMTP_PASSWORD=
SOTA_NOTIFY__EMAIL_FROM=
SOTA_NOTIFY__EMAIL_TO=
SOTA_NOTIFY__MACOS=true

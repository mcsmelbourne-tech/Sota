# Copy to .env and fill in. Never commit .env.

# backtest | paper | live   (live = advisory tickets only; the tool never places live orders)
SOTA_MODE=paper
SOTA_SELECTOR=threshold            # threshold | llm | oracle
SOTA_COST_PRESET=paper             # paper | robinhood | ibkr
# SOTA_UNIVERSE=["SPY","QQQ","AAPL","NVDA","TSLA"]

# Account & risk profile. Paper sizes against min(real equity, SOTA_SIZING_NAV); live uses
# `sota live set-nav`; backtests use --nav. Everything under SOTA_LIMITS__ maps to RiskLimits.
# SOTA_SIZING_NAV=25000                        # size the paper account like your real one
# SOTA_LIMITS__HEDGE=false                     # retail accounts don't delta-hedge with shares
# SOTA_LIMITS__TARGET_RISK_FRAC=0.01           # 1% one-day risk per package (paper: 0.5% at $1M)
# SOTA_LIMITS__FAMILIES=["ol","dv","cv","dg","ib","ic","bf"]   # drop ls/lg when unhedged
# SOTA_THRESHOLD_GATE=false                    # paper's ts<0 participation gate (rarely fires)
# SOTA_THRESHOLD_TENOR=8-30                    # 0-7 | 8-30 | 31-90 | 91-180
# SOTA_COSTS__HALF_SPREAD_MULT=0.5          # fills this far from the mark, on top of the preset

# Alpaca paper account (also used read-only for live quotes in live mode)
SOTA_ALPACA__API_KEY=
SOTA_ALPACA__SECRET_KEY=
SOTA_ALPACA__FEED=indicative       # opra requires the paid options data subscription

# Theta Data (backtests). transport: library = thetadata package with an API key, no Terminal needed;
#                         rest = Theta Terminal v3 running locally on :25503
SOTA_THETA__TRANSPORT=library
SOTA_THETA__API_KEY=               # https://www.thetadata.net/portal/api_key (THETADATA_API_KEY also works)
SOTA_THETA__BASE_URL=http://127.0.0.1:25503/v3
SOTA_THETA__REQUESTS_PER_MINUTE=20 # Free tier cap; set 0 on Value/Standard (they limit concurrency, not rate)

# LLM selector (any OpenAI-compatible endpoint)
SOTA_LLM__BASE_URL=https://api.openai.com/v1
SOTA_LLM__API_KEY=
SOTA_LLM__MODEL=gpt-4.1

# Notifications
SOTA_NOTIFY__TELEGRAM_BOT_TOKEN=
SOTA_NOTIFY__TELEGRAM_CHAT_ID=
SOTA_NOTIFY__SMTP_HOST=
SOTA_NOTIFY__SMTP_PORT=587
SOTA_NOTIFY__SMTP_USER=
SOTA_NOTIFY__SMTP_PASSWORD=
SOTA_NOTIFY__EMAIL_FROM=
SOTA_NOTIFY__EMAIL_TO=
SOTA_NOTIFY__MACOS=true

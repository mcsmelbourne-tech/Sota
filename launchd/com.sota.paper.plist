<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sota.paper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__REPO__/scripts/paper_run.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <!-- Two local firings bracket 15:50 America/New_York across US DST changes; the script picks one. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>1</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>3</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>4</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>1</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>2</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>3</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>4</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>45</integer><key>Weekday</key><integer>5</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>__REPO__/data/paper/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/data/paper/launchd.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
